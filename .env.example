# Supabase project settings — copy this file to .env.local and fill in real values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only used server-side (admin page actions) — never expose in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Simple password gate for /admin — replace with something real before deploying.
# Also used as the signing key for the admin session cookie, so changing it
# logs every admin session out.
ADMIN_PASSWORD=change-me

# The stable public URL the QR code points at (no trailing slash).
# Leave blank locally — /admin/qr falls back to the request's own host.
NEXT_PUBLIC_SITE_URL=
